# Public origin used to generate absolute canonical and social metadata URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Backend address reachable by the Next.js server on the shared machine.
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:3005"
# Server-only upstream used by /api/auth and /api/backend proxies.
BACKEND_URL="http://127.0.0.1:3005"
